# PostgreSQL (자체 설치, localhost 전용 권장)
DATABASE_URL=postgresql://temple:CHANGE_ME@localhost:5432/temple

# 운영 도메인
NEXT_PUBLIC_SITE_URL=https://example.kr

# 카카오 지도 JavaScript 키(선택). 미설정 시 오시는 길 지도는 OpenStreetMap 으로 표시.
# 발급: https://developers.kakao.com → 앱 생성 → 앱 키 → JavaScript 키
#       + 플랫폼 > Web 에 도메인 등록(예: http://localhost:3000, 운영 도메인)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 운영자 세션 시크릿 (필수, 32자 이상). NEXT_PUBLIC_ 접두어 절대 금지.
# 생성: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
