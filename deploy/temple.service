# /etc/systemd/system/temple.service
# 배치: sudo cp deploy/temple.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=Temple Website (Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/temple
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/projects/temple/.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
